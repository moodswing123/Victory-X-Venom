# Copy this file to .env and fill in your real Telegram BotFather token.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_NEW_BOTFATHER_TOKEN

# Both IDs receive full owner privileges.
OWNER_TELEGRAM_ID_1=REPLACE_WITH_FIRST_OWNER_TELEGRAM_ID
OWNER_USERNAME_1=@first_owner_username
DEVELOPER_LINK_1=https://t.me/first_developer_username
OWNER_TELEGRAM_ID_2=REPLACE_WITH_SECOND_OWNER_TELEGRAM_ID
OWNER_USERNAME_2=@second_owner_username
DEVELOPER_LINK_2=https://t.me/second_developer_username

# WhatsApp force-join settings.
FORCE_JOIN_ENABLED=true
FORCE_JOIN_CHANNEL_JID=your_channel_id@newsletter
FORCE_JOIN_GROUP_JID=your_group_invite_code_or_jid

# Telegram force-join channels (four supported).
REQUIRED_CHANNEL_1_NAME=First required channel
REQUIRED_CHANNEL_1_LINK=https://t.me/first_required_channel
REQUIRED_CHANNEL_1_USERNAME=first_required_channel
REQUIRED_CHANNEL_2_NAME=Second required channel
REQUIRED_CHANNEL_2_LINK=https://t.me/second_required_channel
REQUIRED_CHANNEL_2_USERNAME=second_required_channel
REQUIRED_CHANNEL_3_NAME=Third required channel
REQUIRED_CHANNEL_3_LINK=https://t.me/third_required_channel
REQUIRED_CHANNEL_3_USERNAME=third_required_channel
REQUIRED_CHANNEL_4_NAME=Fourth required channel
REQUIRED_CHANNEL_4_LINK=https://t.me/fourth_required_channel
REQUIRED_CHANNEL_4_USERNAME=fourth_required_channel

# Bot media URLs.
IMG_MAIN=https://cdn.kord.live/serve/g6bZo41kYKxd.jpg
IMG_OWNER=https://cdn.kord.live/serve/jLLPbVkbrr85.jpg
IMG_RAID=https://cdn.kord.live/serve/bEBLDr26X77E.jpg
IMG_THANKS=https://cdn.kord.live/serve/vEdgn9OKDFUS.jpg
CATBOX_THUMBNAIL=https://cdn.kord.live/serve/g6bZo41kYKxd.jpg
